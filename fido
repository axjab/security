# /etc/pam.d/fido — imported by sudo before its existing common-auth rules.
# The gate detects Yubico USB + FIDO readiness; failure skips one module.
auth [success=ignore default=1] pam_exec.so quiet quiet_log /usr/local/libexec/fido-prompt 9
# The helper returns success ONLY if fido-worker's pam_u2f authenticated.
# A failure, Ctrl+C, or timeout proceeds to the calling password stack.
auth [success=done default=ignore] pam_exec.so quiet quiet_log /usr/local/libexec/fido-auth
